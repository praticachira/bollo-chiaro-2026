{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bollo-chiaro-2026",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AI_MODEL": "gpt-5.6-terra",
    "SESSION_DAYS": "14",
    "FREE_PDF_URL": "https://stan.store/FEURRADIGITAL/p/non-pagare-il-bollo-auto-guida-completa-legge-104"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bollo-chiaro-2026",
      "database_id": "1943c89d-a8f6-474d-ab33-7cd5c38464be"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
